/// <summary>
/// Represents the choice {{bacnetName}} as defined in ANSI/ASHRAE 135-2024 Clause 21.
/// </summary>
public partial record class {{className}}
{
    /// <summary>
    /// Represents the tag choice of this choice type.
    /// </summary>
    public enum Option : byte
    {
    {{#each items}}
        {{#if description}}
        /// <summary>
        /// {{description}}
        /// </summary>
        {{/if}}
        {{name}}{{#unless @last}},
        {{/unless}}

    {{/each}}
    }

    /// <summary>
    /// The active choice of this instance.
    /// </summary>
    public Option Choice { get; }

    private readonly object _choiceValue;

    private {{className}}(Option choice, object value)
    {
        ArgumentNullException.ThrowIfNull(value);
        Choice = choice;
        _choiceValue = value;
    }

{{#each items}}
    {{#if description}}
    /// <summary>
    /// {{description}}
    /// </summary>
    {{/if}}
    public {{type}} {{name}}
    {
        get
        {
            if (Choice != Option.{{name}})
            {
                throw new InvalidOperationException($"The active choice is {Choice}, not {(Option.{{name}})}.");
            }
            return ({{type}})_choiceValue;
        }
    }

    /// <summary>
    /// Tries to get the value when the active choice is <see cref="Option.{{name}}"/>.
    /// </summary>
    public bool TryGet{{name}}(out {{type}} value)
    {
        if (Choice == Option.{{name}})
        {
            value = ({{type}})_choiceValue;
            return true;
        }

        value = default!;
        return false;
    }
    
    {{#if description}}
    /// <summary>
    /// Creates a choice with the <see cref="Option.{{name}}"/> option.
    /// </summary>
    {{/if}}
    public static {{../className}} From{{name}}({{type}} value)
    {
        return new {{../className}}(Option.{{name}}, value);
    }{{#unless @last}}
    {{/unless}}

{{/each}}
}
