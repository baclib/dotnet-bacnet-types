using Baclib.Bacnet.Types;

namespace Baclib.Bacnet.Serialization.Asn1.Codecs;

public sealed class {{className}}Asn1Codec : Asn1Codec<{{csharpType}}>
{
    private {{className}}Asn1Codec()
    {
    }

    public static readonly {{className}}Asn1Codec Instance = new();

    public override int GetEncodedSize(in {{csharpType}} value) => AsduLength.{{lengthConst}};

    public override int GetEncodedSize(byte tagNumber, in {{csharpType}} value) => AsduLength.Sum(tagNumber, AsduLength.{{lengthConst}});

    public override void Encode(ref AsduEncoder encoder, in {{csharpType}} value)
    {
        encoder.Encode(ApplicationTagNumber.{{tagName}}, value ? 1 : 0);
    }

    public override void Encode(ref AsduEncoder encoder, byte tagNumber, in {{csharpType}} value)
    {
        var bytes = encoder.Encode(tagNumber, AsduLength.{{lengthConst}});
        AsduEncoder.WriteBoolean(bytes, value);
    }

    private static {{csharpType}} Convert(int value)
    {
        return value switch
        {
            0 => false,
            1 => true,
            _ => throw new AsduException($"Invalid boolean value: {value}")
        };
    }

    public override {{csharpType}} Decode(ref AsduDecoder decoder)
    {
        var value = decoder.DecodeTag(ApplicationTagNumber.{{tagName}});
        return Convert(value);
    }

    public override {{csharpType}} Decode(ref AsduDecoder decoder, byte tagNumber)
    {
        var bytes = decoder.Decode(tagNumber, AsduLength.{{lengthConst}});
        if (bytes.Length != 1)
        {
            throw new AsduException($"Invalid boolean length: {bytes.Length}");
        }
        return Convert(bytes[0]);
    }

    public override Optional<{{csharpType}}> DecodeOptional(ref AsduDecoder decoder)
    {
        if (decoder.DecodeOptionalTag(ApplicationTagNumber.{{tagName}}, out var value))
        {
            return Convert(value);
        }
        return default;
    }

    public override Optional<{{csharpType}}> DecodeOptional(ref AsduDecoder decoder, byte tagNumber)
    {
        var bytes = decoder.DecodeOptional(tagNumber, AsduLength.{{lengthConst}});
        if (!bytes.IsEmpty)
        {
            if (bytes.Length != 1)
            {
                throw new AsduException($"Invalid boolean length: {bytes.Length}");
            }
            return Convert(bytes[0]);
        }
        return default;
    }
}
